# Public Supabase browser/server client config
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public production URL used for auth redirects, metadata, ID verification links, and emails
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Email notifications for approval/rejection
# Keep these server-only. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="AlumniHub <noreply@your-domain.com>"

# Branding and launch text
NEXT_PUBLIC_SCHOOL_NAME="Your School AlumniHub"
NEXT_PUBLIC_SCHOOL_SHORT_NAME="AlumniHub"
NEXT_PUBLIC_SCHOOL_TAGLINE="Private alumni network for verified members."
NEXT_PUBLIC_SITE_DESCRIPTION="A private alumni network for verified members, events, directory, gallery, fund ledger, and digital ID verification."

# Public payment instructions shown on the member fund page
NEXT_PUBLIC_PAYMENT_ACCOUNT_NAME="Your Alumni Association"
NEXT_PUBLIC_PAYMENT_BKASH="01XXXXXXXXX"
NEXT_PUBLIC_PAYMENT_NAGAD="01XXXXXXXXX"
NEXT_PUBLIC_PAYMENT_BANK="Bank name, account number, branch"
